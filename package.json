{
  "name": "right-click-restore",
  "version": "1.0.1",
  "description": "Safari Web Extension & macOS/iOS companion app to restore right-click, selection, copy, and video playback with DOM clobbering defenses and Apple HIG liquid glass UI.",
  "author": "Mars Pater",
  "license": "MIT",
  "homepage": "https://github.com/marspater/right-click-restore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marspater/right-click-restore.git"
  },
  "bugs": {
    "url": "https://github.com/marspater/right-click-restore/issues"
  },
  "keywords": [
    "safari",
    "safari-extension",
    "webextension",
    "macos",
    "ios",
    "macos-27",
    "right-click",
    "context-menu",
    "anti-shield",
    "unblur-video",
    "dom-clobbering-defense",
    "svelte5",
    "tailwind4"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "watch": "bun run scripts/build.ts --watch",
    "test": "bun test",
    "type-check": "tsc --noEmit",
    "check": "biome check --config-path=. .",
    "format": "biome format --write --config-path=. .",
    "fix": "biome check --write --unsafe --config-path=. .",
    "lint": "biome check --config-path=. .",
    "check:write": "biome check --write --config-path=. ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@tailwindcss/cli": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "happy-dom": "^21.0.4",
    "svelte": "^5.57.3",
    "svelte-preprocess": "^6.0.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
