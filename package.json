{
  "name": "right-click-restore-extension",
  "version": "1.1.0",
  "description": "Safari Web Extension restoring right-click context menus and text selection",
  "private": true,
  "scripts": {
    "check": "npx @biomejs/biome check --config-path=. .",
    "check:write": "npx @biomejs/biome check --write --config-path=. .",
    "format": "npx @biomejs/biome format --write --config-path=. .",
    "lint": "npx @biomejs/biome lint --config-path=. ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10"
  }
}
