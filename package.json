{
  "name": "right-click-restore",
  "version": "1.0.1",
  "description": "Safari Web Extension & macOS App to restore right-click, selection, and copy operations with Apple HIG liquid glass UI.",
  "author": "Mars Pater",
  "license": "MIT",
  "homepage": "https://github.com/marspater/right-click-restore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marspater/right-click-restore.git"
  },
  "bugs": {
    "url": "https://github.com/marspater/right-click-restore/issues"
  },
  "keywords": [
    "safari",
    "safari-extension",
    "webextension",
    "macos",
    "macos-27",
    "right-click",
    "context-menu",
    "svelte5"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "watch": "bun run scripts/build.ts --watch",
    "test": "bun test",
    "check": "biome check --config-path=. .",
    "format": "biome format --write --config-path=. .",
    "fix": "biome check --write --unsafe --config-path=. .",
    "lint": "biome check --config-path=. .",
    "check:write": "biome check --write --config-path=. ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/chrome": "^0.0.308",
    "esbuild": "^0.25.0",
    "esbuild-svelte": "^0.9.0",
    "happy-dom": "^20.12.0",
    "postcss": "^8.5.0",
    "svelte": "^5.20.0",
    "svelte-preprocess": "^6.0.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
