{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["chrome", "svelte"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "scripts/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
